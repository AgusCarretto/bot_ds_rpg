# Variables del servidor (VPS) para docker-compose.yml. Copiá este archivo a ".env" EN EL SERVIDOR y completá los valores:
#   cp deploy/prod.env.example .env
# Ese ".env" nunca se commitea (está en .gitignore) ni entra a la imagen de Docker (.dockerignore).
# No es el .env de desarrollo de tu PC (ese usa otros nombres: Discord__Token, etc.).

# Token del bot de PRODUCCIÓN (Discord Developer Portal > tu aplicación > Bot > Reset Token). Distinto del de desarrollo:
# con el mismo token en dos lugares los dos responden cada comando y se pisan.
DISCORD_TOKEN=

# ID del servidor de Discord donde juegan (click derecho al server > Copiar ID, con el Modo Desarrollador activado).
DISCORD_GUILD_ID=

# Contraseña de la base. Usá SOLO letras y números: va dentro de una cadena de conexión y un ";" o "=" la rompería.
POSTGRES_PASSWORD=

# Opcional. 2 por defecto (lo normal). No lo pongas en 1 en producción.
# RAID_MIN_PARTICIPANTS=2
