# Copiá este archivo a ".env" y completá los valores reales.
# ".env" está en .gitignore: nunca se commitea.
# Notar el doble guion bajo "__" para representar la jerarquía (Discord:Token -> Discord__Token).

Discord__Token=
# ID de tu servidor de Discord de pruebas: los comandos se propagan al instante ahí
# (a diferencia del registro global, que puede tardar hasta 1h). Click derecho al server -> Copiar ID
# (necesita Modo Desarrollador activado en Discord: Configuración -> Avanzado).
Discord__TestGuildId=
Postgres__ConnectionString=Server=localhost;Port=5432;Database=asado-y-acero;User Id=postgres;Password=

# Opcional: mínimo de jugadores para arrancar un /raid (2 por defecto). Con 1 podés probar el
# flujo completo de botones vos solo, sin una segunda cuenta.
# Raid__MinParticipants=1

# Opcional: imagen del herrero para /blacksmith (URL pública de una imagen; sin esto el herrero habla igual, sin foto)
# Images__Blacksmith=https://...
# Opcional: lo mismo para el tabernero (/taberna y /heal)
# Images__Innkeeper=https://...

# Opcional: minieventos al azar en el canal (valores por defecto: 3% por comando, uno cada 30 min por canal, 15 s para sumarse).
# Para probarlos: ChancePercent=100 y ChannelCooldownMinutes=0 (aparece uno en cada comando).
# MiniEvent__ChancePercent=3
# MiniEvent__ChannelCooldownMinutes=30
# MiniEvent__JoinSeconds=15
